# Backend API, used by server rendering and by the /api/v1 forwarding in next.config.ts.
SERVER_API_BASE=http://127.0.0.1:8000/api/v1

# Image uploads use Vercel Blob. On Vercel, connecting a Blob store sets BLOB_STORE_ID and
# BLOB_WEBHOOK_PUBLIC_KEY. Local uploads also need `vercel env pull` for those credentials.
