            },
            "description": "Search keyword"
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(all|articles|projects)$",
              "default": "all",
              "title": "Scope"
            }
          },
          {
            "name": "limit",
            "in": "query",
