# Backend environment variables. The backend refuses to start without the first two.

# PostgreSQL URL. Hosted URLs such as Neon's can be pasted as they are.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/duole_blog

# JWT signing key: a private random string of at least 32 characters.
SECRET_KEY=

# The Author account, created on first start only. Later changes here have no effect.
# Change the password in the site's 修改密码 page instead.
AUTHOR_EMAIL=
AUTHOR_PASSWORD=

# Must be false for local http development. Leave unset (true) in production.
COOKIE_SECURE=false

# Fill an empty database with demo content. Local development only.
SEED_DEMO_DATA=true

# Optional
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
REDIS_URL=
REDIS_DEFAULT_TTL=300
