# Backend environment variables

# PostgreSQL async URL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/duole_blog

# JWT secret key (replace in real environments)
SECRET_KEY=replace-this-with-a-long-random-string

# JWT token ttl in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional runtime host/port for script-based startup
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional Redis cache. Leave empty to use database-only mode.
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=300
